#!/bin/sh
# Launch the official Hermes Desktop app.
#
# Nothing third-party is installed here: the app comes from the same installer the terminal
# agent uses (hermes-agent.nousresearch.com), and `hermes desktop` is its own desktop launcher.
# The image build already ran `hermes desktop --build-only`, so the packaged artifact exists and
# the first attempt below usually starts it straight away. If it was never built (for example a
# custom image without that step), the fallback compiles it on the spot - that takes a few
# minutes the first time and prints progress in this window.
export PATH="/home/ubuntu/.local/bin:/usr/local/bin:$PATH"
cd "${HOME:-/home/ubuntu}" || exit 1
if hermes desktop --skip-build >/tmp/hermes-desktop.log 2>&1; then
  exit 0
fi
echo "Hermes Desktop was not prebuilt; building it now (a few minutes, once)." >&2
exec hermes desktop
